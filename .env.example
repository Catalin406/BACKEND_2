# ============================================================
# PLANTILLA DE VARIABLES DE ENTORNO
# Copiar a .env (Copy-Item .env.example .env) y completar valores.
# ============================================================
SECRET_KEY=cambia-esta-clave-por-una-larga-y-aleatoria
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1,testserver

# ------------------------------------------------------------
# Conexión a PostgreSQL
# ------------------------------------------------------------
DB_NAME=academia_bootcamps_db
DB_USER=catalina
DB_PASSWORD=tu-contraseña-de-postgresql
DB_HOST=localhost
DB_PORT=5432

# ------------------------------------------------------------
# Datos de la alumna y nombre comercial
# ------------------------------------------------------------
ALUMNO_NOMBRE=Catalina Quezada Sanzana
ALUMNO_SECCION=IEC-N4-C2
ALUMNO_ANIO=2026
NOMBRE_COMERCIAL=CodeLab Academy

# ------------------------------------------------------------
# Despliegue en el servidor (Nginx + HTTPS) y Transbank Webpay Plus
# OJO: python-decouple trata una variable presente pero VACÍA como
# valor "" (no usa el valor por defecto). Para usar el ambiente de
# integración con las credenciales públicas del SDK, OMITE (o deja
# comentadas) las líneas TRANSBANK_*. No las dejes con el signo = vacío.
# ------------------------------------------------------------
# TRANSBANK_AMBIENTE=integracion
# TRANSBANK_CODIGO_COMERCIO=
# TRANSBANK_API_KEY=
# Solo en el servidor (en local se omiten):
# CSRF_TRUSTED_ORIGINS=https://tu-subdominio.duckdns.org
# DETRAS_DE_PROXY_HTTPS=True
